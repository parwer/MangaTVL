# --- LLM provider key (set the one matching PROVIDER below) ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=          # used by the gemini provider (note: GOOGLE_API_KEY, not GEMINI_API_KEY)

# --- pipeline config (read by main.py) ---
DEVICE=cpu               # cpu | cuda  (use cuda only with the GPU image + --gpus all)
PROVIDER=openrouter      # openrouter | gemini | groq
MODEL=google/gemini-3-flash-preview

# --- concurrency: max simultaneous LLM API calls (must be an int) ---
CONCURRENT_REQUESTS=4
