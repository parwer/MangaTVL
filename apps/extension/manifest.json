{
  "manifest_version": 3,
  "name": "MangaTVL — one-click manga translator",
  "version": "0.1.0",
  "description": "Translate manga pages in place. No API-key copy/paste: sign in with OpenRouter, or run fully local.",
  "permissions": ["storage", "identity", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "MangaTVL" },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
